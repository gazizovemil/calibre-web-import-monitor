# Host timezone
TZ=UTC

# Web UI
MONITOR_PORT=8087
CWA_WEB_URL=http://192.168.1.5:8084

# Host paths mounted read-only into the monitor
CWA_CONFIG_PATH=/path/to/calibre-web/config
CWA_INBOX_PATH=/path/to/cwa-book-ingest
CWA_LIBRARY_PATH=/path/to/calibre-library

# Persistent monitor state
MONITOR_DATA_PATH=./data

# UI language
DEFAULT_LANGUAGE=en

# Container user. The data directory must be writable by this account.
PUID=1000
PGID=1000

# Monitoring
POLL_SECONDS=1
EVENT_LIMIT=500
STALL_THRESHOLD_SECONDS=600
BATCH_COMPLETE_GRACE_SECONDS=20
LIBRARY_SCAN_SECONDS=30
FAILED_SCAN_SECONDS=15
HEALTH_STALE_SECONDS=120

# Optional API token. Put the value in secrets/monitor_token instead of this file.
# When it is set, status and covers require sign-in.
# Telegram test/status actions always require it.
# MONITOR_TOKEN=

# Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_LANGUAGE=en
TELEGRAM_PROGRESS_INTERVAL=900
TELEGRAM_NOTIFY_ERRORS=true
